# Personal Spotify developer application (Web API).
# Register this exact redirect URI in your Spotify dashboard.
SPOTIFY_CLIENT_ID=your_client_id
SPOTIFY_CLIENT_SECRET=your_client_secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/auth/callback
# Automatically generated by: python manage.py setup
SPOTIFY_TOKEN_ENCRYPTION_KEY=generate_during_setup

FRONTEND_AUTH_SUCCESS_URL=http://127.0.0.1:5173/
FRONTEND_ORIGIN=http://127.0.0.1:5173
APP_COOKIE_SECURE=false
AUTH_DATABASE_PATH=data/auth/auth.db

# Optional PostgreSQL deployment; apply Alembic migrations before starting.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/music_recommendations
